rules_version = '2';

// RentTracker security rules.
// All owner data lives under users/{uid}/... so every document is scoped to its
// owner. Collection-group queries (apartments, rentRecords) additionally filter
// on ownerId == uid, which these rules enforce via the document path.
service cloud.firestore {
  match /databases/{database}/documents {

    // The owner's profile document and everything nested beneath it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
